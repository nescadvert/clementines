generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model DeliveryPoint {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  dayOfWeek Int      @default(2) // 1=Lundi, 2=Mardi, 3=Mercredi, 4=Jeudi, 5=Vendredi, 6=Samedi, 0=Dimanche
  timeSlot  String   @default("16h30 - 18h00")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  active      Boolean     @default(true)
  orderItems  OrderItem[]
}

model Order {
  id              String        @id @default(cuid())
  customerName    String
  customerPhone   String
  totalPrice      Float
  status          String        @default("PENDING")
  deliveryDate    String?
  deliveryPointId String
  deliveryPoint   DeliveryPoint @relation(fields: [deliveryPointId], references: [id])
  items           OrderItem[]
  createdAt       DateTime      @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}
